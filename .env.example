# Copy to .env and set real values. .env is git-ignored; never commit it.

# --- Docker Compose (PostgreSQL) ---
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# --- Application (APP_*) ---
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
# APP_LOG_FORMAT: json (default) or text (easier to read locally)
APP_LOG_FORMAT=json
# Compose builds APP_DATABASE_URL from the POSTGRES_* values above.
# For running the app directly on your machine, set it yourself, e.g.:
# APP_DATABASE_URL=sqlite:///./app.db
APP_DEFAULT_PAGE_SIZE=20
APP_MAX_PAGE_SIZE=100
APP_DB_POOL_SIZE=5
APP_DB_MAX_OVERFLOW=5

# --- Observability (docker-compose.observability.yml) ---
GRAFANA_ADMIN_PASSWORD=change-me

# --- API write access (scripts/new-api-key.sh) ---
# Server side: comma-separated SHA-256 hashes. With none, production rejects writes.
APP_API_KEY_HASHES=
# Client side, for local scripts only (smoke test, load probe). Never commit a real key.
API_KEY=
